# LLM API Key (Anthropic Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Token (Optional for public repos, recommended for private repos and higher rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# Database URL: SQLite default or PostgreSQL
# e.g., postgresql+psycopg2://user:password@localhost:5432/engineering_assistant
DATABASE_URL=sqlite:///./engineering_assistant.db

# Vector DB storage directory
VECTOR_DB_PATH=./chroma_data

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Mock mode toggle: if ANTHROPIC_API_KEY is not set or MOCK_LLM=true, high quality simulated AI responses are returned
MOCK_LLM=false
